# Contact form (src/app/api/contact/route.ts)
# Without RESEND_API_KEY the form shows an honest error plus the mailto fallback.
RESEND_API_KEY=

# Optional. Where messages are delivered (defaults to the email in src/lib/content/profile.ts).
CONTACT_TO_EMAIL=

# Optional. A sender on a domain you have verified in Resend, e.g. "Portfolio <contact@yourdomain.com>".
# Without it the shared Resend testing sender is used, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=

# Optional. Public URL for metadata, Open Graph and the sitemap. On Vercel this is detected
# automatically (see src/lib/site.ts); only set it for a custom domain.
NEXT_PUBLIC_SITE_URL=
